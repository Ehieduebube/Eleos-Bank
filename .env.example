# Copy to .env.local and fill in what you need. Never commit real values.
# With NOTHING set, Eleos runs in local demo mode (file-backed store + local sessions).

# --- Supabase (optional: enables Postgres + Supabase Auth) -------------------
# Public project URL and publishable/anon key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Required in Supabase mode: ledger functions run with this key.
# Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used in auth email links (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_APP_URL=

# --- Demo access ---------------------------------------------------------------
# "Explore the demo account" button. Set to false to hide it.
DEMO_ACCESS_ENABLED=
# Supabase mode only: shared demo login created by `npm run db:seed`.
# If unset, the demo button uses Supabase anonymous sign-ins (enable them in Auth settings).
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# --- Local demo store ---------------------------------------------------------
# Force local mode even when Supabase variables are present: ELEOS_DATA_MODE=local
ELEOS_DATA_MODE=
# Where the local store lives (default: ./.data/eleos-demo-db.json).
LOCAL_DATA_FILE=

# --- Payments -----------------------------------------------------------------
# Leave unset (= demo). "live" blocks all payments until a verified live adapter exists.
PAYMENTS_MODE=

# Future live adapters (server only, sandbox keys first). Not used by the demo build.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
